# kibanCMS — conteúdos do site lidos no browser (ver cms/README.md)
# Copiar para ".env" (local) e definir as mesmas variáveis no serviço de alojamento/build.

# API do kibanCMS (o tenant é escolhido pelo header X-Tenant)
VITE_KIBAN_API_URL=https://kiban.pt/api/v1
VITE_KIBAN_TENANT=hakura

# API key de um utilizador com role "viewer" (SÓ LEITURA).
# Fica pública no código do site — nunca usar a key de um admin/editor.
VITE_KIBAN_API_KEY=
